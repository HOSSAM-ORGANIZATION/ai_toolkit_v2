#!/usr/bin/env bash
# Universal AI Toolkit v2 — Master CLI Dispatcher
# Zero external dependencies. Works on macOS, Linux, Git Bash, WSL.

set -e

TOOLKIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat << EOF
Universal AI Toolkit v2 (Master CLI)

Usage:
  toolkit <command> [options]

Core Commands:
  setup [MODULE] / quickstart          One-shot setup or modular setup (signing, permissions, icons-splash, network, updater, cloud)
  init [--prd PATH] [--preset NAME]   Run interactive project profile wizard
  add <BLUEPRINT> [options]            Scaffold on-demand UI/Pattern/Utility building blocks
  check [PATH]                         Validate project_profile.yaml integrity
  plan-split <PATH | --all>            Rotate completed phases from plan.md to history.md
  context <FEATURE> [PHASE]            Calculate resolved token load budget
  deps / packages [sync]               Sync required pub.dev packages based on project profile
  flavors [setup]                      Configure modern Android & iOS flavors and entrypoints
  cloud / register [options]           Provision Firebase, Apple App Store, and Google Play Console
  permissions [MODULES]                Configure Android & iOS permissions (media, location, notifications)
  signing                              Configure Android keystore and release signing
  icons-splash                         Configure launcher icons & native splash for all flavors
  l10n <SUBCOMMAND>                    Sync and update ARB / JSON / Slang translations
  fonts [options]                      Setup, match, or provision fonts (cairo, inter, custom)
  pulse / sync-state                   Audit features, rotate plan to history, and sync living memory
  qa <run|gen|status> [FEATURE]        Autonomous QA, Maestro flows & UI verification
  verify                               Verify integrity of toolkit rules, links, and templates

Submodule Management:
  sync                                 Checkout pinned submodule commit
  pull                                 Pull latest toolkit updates & re-sync IDE rules
  push "MESSAGE"                       Commit and push toolkit modifications
  status                               Show submodule Git status
  help                                 Show this message

EOF
}

cmd="$1"
shift || true

case "$cmd" in
  setup)
    sub="$1"
    case "$sub" in
      signing)
        shift || true
        python3 "$TOOLKIT_DIR/bin/setup/setup_signing.py" "$@"
        ;;
      icons-splash|icons|splash)
        shift || true
        python3 "$TOOLKIT_DIR/bin/setup/setup_icons_splash.py" "$@"
        ;;
      permissions)
        shift || true
        python3 "$TOOLKIT_DIR/bin/setup/setup_permissions.py" "$@"
        ;;
      network|interceptors)
        shift || true
        python3 "$TOOLKIT_DIR/bin/setup/setup_network.py" "$@"
        ;;
      updater)
        shift || true
        python3 "$TOOLKIT_DIR/bin/setup/setup_updater.py" "$@"
        ;;
      cloud|register)
        shift || true
        python3 "$TOOLKIT_DIR/bin/setup/setup_cloud.py" "$@"
        ;;
      *)
        bash "$TOOLKIT_DIR/setup/quickstart.sh" "$@"
        ;;
    esac
    ;;
  quickstart)
    bash "$TOOLKIT_DIR/setup/quickstart.sh" "$@"
    ;;
  signing)
    python3 "$TOOLKIT_DIR/bin/setup/setup_signing.py" "$@"
    ;;
  permissions)
    python3 "$TOOLKIT_DIR/bin/setup/setup_permissions.py" "$@"
    ;;
  icons-splash)
    python3 "$TOOLKIT_DIR/bin/setup/setup_icons_splash.py" "$@"
    ;;
  cloud|register)
    python3 "$TOOLKIT_DIR/bin/setup/setup_cloud.py" "$@"
    ;;
  init)
    python3 "$TOOLKIT_DIR/bin/wizard/init_profile.py" "$@"
    ;;
  add|blueprint)
    python3 "$TOOLKIT_DIR/bin/scaffolder/add_blueprint.py" "$@"
    ;;
  check)
    python3 "$TOOLKIT_DIR/bin/check-profile" "$@"
    ;;
  plan-split)
    python3 "$TOOLKIT_DIR/bin/plan-splitter" "$@"
    ;;
  context)
    python3 "$TOOLKIT_DIR/bin/toolkit-context.py" "$@"
    ;;
  deps|packages)
    python3 "$TOOLKIT_DIR/bin/deps/sync_packages.py" "$@"
    ;;
  flavors)
    python3 "$TOOLKIT_DIR/bin/flavors/setup_flavors.py" "$@"
    ;;
  l10n)
    python3 "$TOOLKIT_DIR/bin/l10n-sync.py" "$@"
    ;;
  fonts)
    python3 "$TOOLKIT_DIR/bin/setup/setup_fonts.py" "$@"
    ;;
  pulse|sync-state)
    python3 "$TOOLKIT_DIR/bin/sync/project_pulse.py" "$@"
    ;;
  qa)
    python3 "$TOOLKIT_DIR/bin/qa/qa_engine.py" "$@"
    ;;
  verify)
    bash "$TOOLKIT_DIR/setup/verify-setup.sh" "$@"
    ;;
  sync)
    echo "🔄 Syncing pinned toolkit commit..."
    git submodule update --init --recursive
    echo "✅ Pinned submodule synchronized."
    ;;
  pull|upgrade)
    echo "⬇️ Pulling latest toolkit changes from origin/main..."
    git -C "$TOOLKIT_DIR" pull origin main
    echo "⚙️ Synchronizing updated IDE skills, rules, and host Makefile..."
    bash "$TOOLKIT_DIR/setup/install.sh"
    echo "✅ Toolkit updated and host project synchronized successfully!"
    ;;
  push)
    msg="$1"
    if [ -z "$msg" ]; then
      echo "❌ Error: Commit message required. Usage: toolkit push \"your message\"" >&2
      exit 1
    fi
    git add -A
    git commit -m "$msg"
    git push origin main
    echo "✅ Toolkit changes pushed to origin/main."
    ;;
  status)
    git status
    ;;
  help|--help|-h|"")
    usage
    ;;
  *)
    echo "❌ Unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
