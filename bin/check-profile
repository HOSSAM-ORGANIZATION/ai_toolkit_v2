#!/usr/bin/env python3
"""
Universal AI Toolkit v2 — Mandatory Profile Gatekeeper
Ensures project_profile.yaml is present, well-formed, and complete before any agent workflow executes.
Uses Python Standard Library ONLY (zero pip dependencies required).
"""

import sys
import os
import re
from pathlib import Path

REQUIRED_KEYS = [
    "project_name",
    "project_type",
    "architecture",
    "state_management",
    "network_client",
    "dependency_injection",
    "navigation",
    "localization",
    "directionality",
    "design_system",
    "testing_gate"
]

def parse_simple_yaml_keys(file_content):
    """Extracts top-level keys from a YAML file without external dependencies."""
    keys = {}
    for line in file_content.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        # Match top-level key: value or key:
        match = re.match(r"^([a-zA-Z0-9_\-]+)\s*:\s*(.*)", line)
        if match:
            k = match.group(1)
            v = match.group(2).strip()
            # strip quotes if present
            v = re.sub(r"^['\"]|['\"]$", "", v)
            keys[k] = v
    return keys

def check_profile(project_root="."):
    profile_path = Path(project_root) / "project_profile.yaml"
    
    if not profile_path.exists():
        print("\n" + "🛑"*35)
        print("  MANDATORY GATEKEEPER HALT: `project_profile.yaml` NOT FOUND!")
        print("🛑"*35)
        print("No AI agent may write or modify code without a locked project profile.\n")
        print("👉 TO FIX THIS, RUN:")
        print("   make toolkit-init")
        print("   OR")
        print("   python3 ai_toolkit/bin/wizard/init_profile.py\n")
        print("The wizard will guide you through setup in under 60 seconds.")
        print("="*70 + "\n")
        sys.exit(1)

    try:
        with open(profile_path, "r", encoding="utf-8") as f:
            content = f.read()
            data = parse_simple_yaml_keys(content)
    except Exception as e:
        print(f"❌ Failed to parse `project_profile.yaml`: {e}")
        sys.exit(1)

    missing = [k for k in REQUIRED_KEYS if k not in data]
    if missing:
        print("\n" + "⚠️"*35)
        print(f"  INCOMPLETE PROFILE: Missing required keys: {missing}")
        print("⚠️"*35)
        print("Please re-run `make toolkit-init` or `init_profile.py` to repair the profile.\n")
        sys.exit(1)

    print(f"✅ Project profile validated: '{data.get('project_name')}' ({data.get('architecture')}, {data.get('state_management')})")
    sys.exit(0)

if __name__ == "__main__":
    target = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else "."
    check_profile(target)
