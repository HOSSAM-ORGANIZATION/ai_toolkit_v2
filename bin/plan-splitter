#!/usr/bin/env python3
"""
Universal AI Toolkit v2 — Automatic Plan Splitter
Enforces strict context budgeting (< 8KB) by rotating completed phases from `plan.md` into `history.md`.
Standard library ONLY.
"""

import sys
import os
import re
from pathlib import Path

MAX_PLAN_BYTES = 8192  # 8 KB strict budget

def split_plan_file(plan_path):
    path = Path(plan_path).resolve()
    if not path.exists() or path.name != "plan.md":
        print(f"⚠️ Skipping non-plan path: {plan_path}")
        return False

    with open(path, "r", encoding="utf-8") as f:
        content = f.read()

    file_size = len(content.encode("utf-8"))
    
    # Check if there are completed phases:
    # Matches patterns like:
    # ## Phase X: ... (Status: Done | Completed)
    # or ## Phase X ... with all items checked [x]
    phase_blocks = re.split(r"(?m)^(?=##\s+Phase\s+\d+)", content)
    
    if len(phase_blocks) <= 1:
        # No standard phase headers found
        return False

    header = phase_blocks[0]
    phases = phase_blocks[1:]
    
    completed_phases = []
    active_phases = []

    for phase in phases:
        # Check if phase is marked complete
        is_done = False
        if re.search(r"(?i)Status:\s*(DONE|COMPLETED)", phase):
            is_done = True
        elif "[ ]" not in phase and "[x]" in phase:
            is_done = True

        if is_done:
            completed_phases.append(phase)
        else:
            active_phases.append(phase)

    if not completed_phases:
        if file_size > MAX_PLAN_BYTES:
            print(f"⚠️ Plan {path} is {file_size} B (> {MAX_PLAN_BYTES} B) but has no completed phases to archive.")
        return False

    # Write completed phases to history.md
    history_path = path.parent / "history.md"
    history_header = "# Feature Execution History\n\n> Archived completed phases from `plan.md`.\n\n"
    
    existing_history = ""
    if history_path.exists():
        with open(history_path, "r", encoding="utf-8") as f:
            existing_history = f.read()

    # Append completed phases to history
    with open(history_path, "w", encoding="utf-8") as f:
        if not existing_history:
            f.write(history_header)
        else:
            f.write(existing_history + "\n\n")
        f.write("\n\n".join(completed_phases).strip() + "\n")

    # Reconstruct plan.md with active phases only
    pointer = "> ℹ️ Completed phases have been archived to [history.md](history.md) to preserve AI context budget.\n\n"
    if "archived to [history.md]" not in header:
        header = header.strip() + "\n\n" + pointer

    new_plan_content = header.strip() + "\n\n" + "\n\n".join(active_phases).strip() + "\n"
    
    with open(path, "w", encoding="utf-8") as f:
        f.write(new_plan_content)

    new_size = len(new_plan_content.encode("utf-8"))
    print(f"✅ Split {path.name}: Moved {len(completed_phases)} completed phase(s) to history.md.")
    print(f"   Size reduced from {file_size} B to {new_size} B (Budget: {MAX_PLAN_BYTES} B).")
    return True

def scan_all_plans(specs_dir="ai_specs"):
    base = Path(specs_dir).resolve()
    if not base.exists():
        print(f"Directory {specs_dir} does not exist.")
        return

    plans = list(base.glob("**/plan.md"))
    print(f"🔍 Found {len(plans)} plan.md files in {specs_dir}...")
    for plan in plans:
        split_plan_file(plan)

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help"]:
        print("Usage: bin/plan-splitter <path_to_plan.md> | --all [specs_dir]")
        sys.exit(0)

    if sys.argv[1] == "--all":
        s_dir = sys.argv[2] if len(sys.argv) > 2 else "ai_specs"
        scan_all_plans(s_dir)
    else:
        split_plan_file(sys.argv[1])
