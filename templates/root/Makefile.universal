# Universal Adaptive Makefile for Flutter Projects
# Generated by Universal AI Toolkit v2
# Usage: `make help`

SHELL := /bin/bash
.DEFAULT_GOAL := help

# --- Configuration & Dynamic Detection -------------------------------------
PROFILE_FILE := project_profile.yaml

# Extract flavors from project_profile.yaml if present
DETECTED_FLAVORS := $(shell [ -f "$(PROFILE_FILE)" ] && python3 -c '
import re
try:
    with open("$(PROFILE_FILE)", "r", encoding="utf-8") as f:
        content = f.read()
    match = re.search(r"flavors\s*:\s*\n((?:\s*-\s*[^\n]+\n)+)", content)
    if match:
        fls = [line.strip().lstrip("-").strip().strip("\"'\") for line in match.group(1).splitlines() if line.strip().startswith("-")]
        print(" ".join(fls))
except:
    pass
' 2>/dev/null)

FLAVORS ?= $(DETECTED_FLAVORS)

# Selected flavor for multi-flavor commands (e.g. `make user run`)
FLAVOR ?= $(firstword $(filter $(FLAVORS),$(MAKECMDGOALS)))

# Submodule configuration
TOOLKIT_REPO ?= https://github.com/HOSSAM-ORGANIZATION/ai_toolkit_v2.git
TOOLKIT_DIR  ?= ai_toolkit
TOOLKIT_BIN  := ./$(TOOLKIT_DIR)/bin/toolkit
CHECK_PROFILE := ./$(TOOLKIT_DIR)/bin/check-profile

.PHONY: run apk aab ipa \
        get codegen clean analyze format test \
        qa qa-feature qa-gen qa-status \
        pulse sync-state fonts fonts-setup font-custom \
        deps-sync flavors-setup cloud-setup \
        icons splash help \
        toolkit-init toolkit-add toolkit-sync toolkit-pull toolkit-push toolkit-status \
        $(FLAVORS) \
        $(addsuffix -run,$(FLAVORS)) \
        $(addsuffix -apk,$(FLAVORS)) \
        $(addsuffix -aab,$(FLAVORS)) \
        $(addsuffix -ipa,$(FLAVORS))

# Flavor name as first goal is a no-op so `make <flavor> run` works smoothly
ifneq ($(FLAVORS),)
$(FLAVORS):
	@:
endif

# Mandatory Gatekeeper check before building or running
check-profile-gate:
	@if [ -x "$(CHECK_PROFILE)" ]; then $(CHECK_PROFILE) .; fi

# --- Run & Build Commands --------------------------------------------------
ifeq ($(strip $(FLAVORS)),)
# Single App Mode (No flavors configured)
run: check-profile-gate
	flutter run

apk: check-profile-gate
	flutter build apk --release

aab: check-profile-gate
	flutter build appbundle --release

ipa: check-profile-gate
	flutter clean
	rm -f ios/Podfile.lock
	flutter pub get
	cd ios && pod update
	flutter build ipa --release

else
# Multi-Flavor Mode
require-flavor = $(if $(FLAVOR),,$(error Usage: make <flavor> $@  (Available flavors: $(FLAVORS))))

run: check-profile-gate
	$(call require-flavor)
	flutter run --flavor $(FLAVOR) -t lib/main_$(FLAVOR).dart --dart-define=APP_FLAVOR=$(FLAVOR)

apk: check-profile-gate
	$(call require-flavor)
	flutter build apk --release --flavor $(FLAVOR) -t lib/main_$(FLAVOR).dart --dart-define=APP_FLAVOR=$(FLAVOR)

aab: check-profile-gate
	$(call require-flavor)
	flutter build appbundle --release --flavor $(FLAVOR) -t lib/main_$(FLAVOR).dart --dart-define=APP_FLAVOR=$(FLAVOR)

ipa: check-profile-gate
	$(call require-flavor)
	flutter clean
	rm -f ios/Podfile.lock
	flutter pub get
	cd ios && pod update
	flutter build ipa --release --flavor $(FLAVOR) -t lib/main_$(FLAVOR).dart --dart-define=APP_FLAVOR=$(FLAVOR)

# Shorthand targets: `make <flavor>-run`, `make <flavor>-apk`
$(foreach fl,$(FLAVORS),$(eval $(fl)-run: ; @$$(MAKE) run FLAVOR=$(fl)))
$(foreach fl,$(FLAVORS),$(eval $(fl)-apk: ; @$$(MAKE) apk FLAVOR=$(fl)))
$(foreach fl,$(FLAVORS),$(eval $(fl)-aab: ; @$$(MAKE) aab FLAVOR=$(fl)))
$(foreach fl,$(FLAVORS),$(eval $(fl)-ipa: ; @$$(MAKE) ipa FLAVOR=$(fl)))

endif

# --- Asset, Icon & Splash Automation --------------------------------------
define sync_ios_splash_storyboards
	@pascal="$$(printf '%s' "$(1)" | awk '{print toupper(substr($$0,1,1)) substr($$0,2)}')"; \
	src="ios/Runner/Base.lproj/LaunchScreen$${pascal}.storyboard"; \
	dst="ios/Runner/LaunchScreen$${pascal}.storyboard"; \
	if [ -f "$$src" ]; then cp -f "$$src" "$$dst"; echo "Synced $$dst"; fi
endef

icons:
	@if [ -n "$(FLAVORS)" ]; then \
		for fl in $(FLAVORS); do \
			if [ -f "flutter_launcher_icons-$${fl}.yaml" ]; then \
				dart run flutter_launcher_icons -f flutter_launcher_icons-$${fl}.yaml; \
			fi \
		done \
	else \
		dart run flutter_launcher_icons; \
	fi

splash:
	@if [ -n "$(FLAVORS)" ]; then \
		for fl in $(FLAVORS); do \
			if [ -f "flutter_native_splash-$${fl}.yaml" ]; then \
				dart run flutter_native_splash:create --flavor $${fl}; \
				$(call sync_ios_splash_storyboards,$${fl}); \
			fi \
		done \
	else \
		dart run flutter_native_splash:create; \
	fi

# --- Core Development Helpers ---------------------------------------------
get:
	flutter pub get

codegen:
	dart run build_runner build --delete-conflicting-outputs

clean:
	flutter clean
	rm -f ios/Podfile.lock
	flutter pub get
	if [ -d "ios" ]; then cd ios && pod update; fi

analyze:
	flutter analyze

format:
	dart format lib test

test:
	flutter test

# --- Autonomous QA & Verification -----------------------------------------
qa:
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) qa run; \
	elif [ -f "ai_toolkit/bin/qa/qa_engine.py" ]; then python3 ai_toolkit/bin/qa/qa_engine.py run; \
	else echo "❌ Toolkit QA runner not found. Run 'make toolkit-add' first."; fi

qa-feature:
	@test -n "$(FEATURE)" || (echo 'Usage: make qa-feature FEATURE=login' >&2; exit 1)
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) qa run $(FEATURE); \
	elif [ -f "ai_toolkit/bin/qa/qa_engine.py" ]; then python3 ai_toolkit/bin/qa/qa_engine.py run $(FEATURE); \
	else echo "❌ Toolkit QA runner not found. Run 'make toolkit-add' first."; fi

qa-gen:
	@test -n "$(FEATURE)" || (echo 'Usage: make qa-gen FEATURE=login' >&2; exit 1)
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) qa gen $(FEATURE); \
	elif [ -f "ai_toolkit/bin/qa/qa_engine.py" ]; then python3 ai_toolkit/bin/qa/qa_engine.py gen $(FEATURE); \
	else echo "❌ Toolkit QA runner not found. Run 'make toolkit-add' first."; fi

qa-status:
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) qa status; \
	elif [ -f "ai_toolkit/bin/qa/qa_engine.py" ]; then python3 ai_toolkit/bin/qa/qa_engine.py status; \
	else echo "❌ Toolkit QA runner not found. Run 'make toolkit-add' first."; fi

# --- Project Pulse & Living Memory Sync ------------------------------------
pulse sync-state:
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) pulse; \
	elif [ -f "ai_toolkit/bin/sync/project_pulse.py" ]; then python3 ai_toolkit/bin/sync/project_pulse.py; \
	elif [ -f "bin/sync/project_pulse.py" ]; then python3 bin/sync/project_pulse.py; \
	else echo "❌ Toolkit pulse engine not found. Run 'make toolkit-add' first."; fi

# --- Fonts Management & Provisioning ---------------------------------------
fonts:
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) fonts --list; \
	elif [ -f "ai_toolkit/bin/setup/setup_fonts.py" ]; then python3 ai_toolkit/bin/setup/setup_fonts.py --list; \
	elif [ -f "bin/setup/setup_fonts.py" ]; then python3 bin/setup/setup_fonts.py --list; \
	else echo "❌ Toolkit fonts runner not found."; fi

fonts-setup:
	@test -n "$(FONTS)" || (echo 'Usage: make fonts-setup FONTS="cairo,inter"' >&2; exit 1)
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) fonts --fonts "$(FONTS)"; \
	elif [ -f "ai_toolkit/bin/setup/setup_fonts.py" ]; then python3 ai_toolkit/bin/setup/setup_fonts.py --fonts "$(FONTS)"; \
	elif [ -f "bin/setup/setup_fonts.py" ]; then python3 bin/setup/setup_fonts.py --fonts "$(FONTS)"; \
	else echo "❌ Toolkit fonts runner not found."; fi

font-custom:
	@test -n "$(PATH)" || (echo 'Usage: make font-custom PATH="/path/to/fonts" NAME="SomarSans"' >&2; exit 1)
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) fonts --custom-font "$(PATH)" --name "$(NAME)"; \
	elif [ -f "ai_toolkit/bin/setup/setup_fonts.py" ]; then python3 ai_toolkit/bin/setup/setup_fonts.py --custom-font "$(PATH)" --name "$(NAME)"; \
	elif [ -f "bin/setup/setup_fonts.py" ]; then python3 bin/setup/setup_fonts.py --custom-font "$(PATH)" --name "$(NAME)"; \
	else echo "❌ Toolkit fonts runner not found."; fi

# --- Package Synchronization & Flavors Setup -------------------------------
deps-sync:
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) deps sync; \
	elif [ -f "ai_toolkit/bin/deps/sync_packages.py" ]; then python3 ai_toolkit/bin/deps/sync_packages.py .; \
	else echo "❌ Toolkit deps runner not found. Run 'make toolkit-add' first."; fi

flavors-setup:
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) flavors setup; \
	elif [ -f "ai_toolkit/bin/flavors/setup_flavors.py" ]; then python3 ai_toolkit/bin/flavors/setup_flavors.py .; \
	else echo "❌ Toolkit flavors runner not found. Run 'make toolkit-add' first."; fi

cloud-setup:
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) cloud $(ARGS); \
	elif [ -f "ai_toolkit/bin/setup/setup_cloud.py" ]; then python3 ai_toolkit/bin/setup/setup_cloud.py $(ARGS); \
	else echo "❌ Toolkit cloud runner not found. Run 'make toolkit-add' first."; fi

# --- Universal AI Toolkit Lifecycle ---------------------------------------
toolkit-init:
	@if [ -f "$(TOOLKIT_DIR)/bin/wizard/init_profile.py" ]; then \
		python3 $(TOOLKIT_DIR)/bin/wizard/init_profile.py --target-dir .; \
	else \
		echo "❌ Toolkit not found in $(TOOLKIT_DIR). Run 'make toolkit-add' first."; \
	fi

toolkit-add:
	@if [ -d "$(TOOLKIT_DIR)" ]; then \
		echo "Toolkit directory $(TOOLKIT_DIR) already exists."; \
	else \
		git submodule add $(TOOLKIT_REPO) $(TOOLKIT_DIR) && \
		git submodule update --init --recursive -- $(TOOLKIT_DIR); \
		echo "✅ Submodule $(TOOLKIT_DIR) registered. Running installer..."; \
		bash $(TOOLKIT_DIR)/setup/install.sh; \
	fi

toolkit-sync:
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) sync; \
	else git submodule update --init --recursive -- $(TOOLKIT_DIR); fi

toolkit-pull:
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) pull; \
	else cd $(TOOLKIT_DIR) && git pull origin main && cd .. && bash $(TOOLKIT_DIR)/setup/install.sh; fi

toolkit-push:
	@test -n "$(MSG)" || (echo 'Usage: make toolkit-push MSG="describe change"' >&2; exit 1)
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) push "$(MSG)"; \
	else cd $(TOOLKIT_DIR) && git add -A && git commit -m "$(MSG)" && git push origin main; fi

toolkit-status:
	@if [ -x "$(TOOLKIT_BIN)" ]; then $(TOOLKIT_BIN) status; \
	else cd $(TOOLKIT_DIR) && git status; fi

# --- Help -----------------------------------------------------------------
help:
	@echo "======================================================================"
	@echo " Universal Adaptive Makefile — Universal AI Toolkit v2"
	@echo "======================================================================"
	@if [ -n "$(FLAVORS)" ]; then \
		echo "Flavors detected: $(FLAVORS)"; \
		echo "  make <flavor> run|apk|aab|ipa"; \
		echo "  make <flavor>-run | <flavor>-apk | <flavor>-aab | <flavor>-ipa"; \
	else \
		echo "Mode: Single Application (no flavors)"; \
		echo "  make run | apk | aab | ipa"; \
	fi
	@echo ""
	@echo "Development commands:"
	@echo "  make get        - Resolve dependencies (pub get)"
	@echo "  make codegen    - Run build_runner code generation"
	@echo "  make clean      - Clean build caches & iOS pods"
	@echo "  make analyze    - Run Flutter static analyzer"
	@echo "  make format     - Format Dart code"
	@echo "  make test       - Execute test suite"
	@echo "  make pulse      - Audit project state, rotate plan to history, & sync memory"
	@echo "  make fonts      - List available bundled fonts"
	@echo "  make fonts-setup FONTS=\"cairo,inter\" - Provision bundled fonts directly"
	@echo "  make font-custom PATH=\"...\" NAME=\"...\" - Provision a custom font & sync docs"
	@echo "  make qa         - Run autonomous QA & Maestro verification suite"
	@echo "  make qa-feature FEATURE=name - Run QA on specific feature"
	@echo "  make qa-gen FEATURE=name     - Generate Maestro flow for feature"
	@echo "  make qa-status  - Check QA tooling and emulator readiness"
	@echo "  make icons      - Generate app icons (flavor-aware)"
	@echo "  make splash     - Generate splash screens (flavor-aware)"
	@echo "  make cloud-setup [ARGS=\"...\"] - Provision Firebase, App Store, and Play Store readiness"
	@echo ""
	@echo "AI Toolkit management:"
	@echo "  make toolkit-init   - Launch interactive project profile wizard"
	@echo "  make toolkit-add    - Add AI Toolkit as Git submodule"
	@echo "  make toolkit-sync   - Sync pinned submodule commit"
	@echo "  make toolkit-pull   - Pull latest toolkit and update IDE rules"
	@echo "  make toolkit-push MSG=\"...\" - Commit and push changes to toolkit"
	@echo "  make toolkit-status - Check submodule Git status"
	@echo "======================================================================"
