import 'package:flutter/material.dart';

/// Callback defining whether the current user is authenticated.
typedef AuthCheckCallback = bool Function();

/// Universal Guest Guard Pattern
/// Intercepts actions that require authentication and presents a clean bottom sheet
/// or dialog when the user is in guest mode.
class GuestGuard {
  /// Global or default auth check resolver (can be set during app initialization)
  static AuthCheckCallback? defaultAuthCheck;

  /// Runs [action] if authenticated; otherwise triggers [onGuestIntercepted] or displays default bottom sheet.
  static void run(
    BuildContext context, {
    required VoidCallback action,
    AuthCheckCallback? isAuth,
    Widget Function(BuildContext)? customGuestDialog,
    VoidCallback? onLoginPressed,
  }) {
    final authenticated = isAuth?.call() ?? defaultAuthCheck?.call() ?? false;

    if (authenticated) {
      action();
    } else {
      if (customGuestDialog != null) {
        showModalBottomSheet(
          context: context,
          isScrollControlled: true,
          shape: const RoundedRectangleBorder(
            borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
          ),
          builder: customGuestDialog,
        );
      } else {
        _showDefaultGuestSheet(context, onLoginPressed: onLoginPressed);
      }
    }
  }

  static void _showDefaultGuestSheet(
    BuildContext context, {
    VoidCallback? onLoginPressed,
  }) {
    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      builder: (ctx) => SafeArea(
        child: Padding(
          padding: const EdgeInsets.symmetric(horizontal: 24.0, vertical: 28.0),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              Container(
                width: 48,
                height: 4,
                decoration: BoxDecoration(
                  color: Colors.grey.shade300,
                  borderRadius: BorderRadius.circular(2),
                ),
              ),
              const SizedBox(height: 24),
              Icon(
                Icons.lock_outline_rounded,
                size: 64,
                color: Theme.of(ctx).colorScheme.primary,
              ),
              const SizedBox(height: 16),
              Text(
                'تسجيل الدخول مطلوب',
                style: Theme.of(ctx).textTheme.titleLarge?.copyWith(
                      fontWeight: FontWeight.bold,
                    ),
              ),
              const SizedBox(height: 8),
              Text(
                'يرجى تسجيل الدخول أو إنشاء حساب جديد لتتمكن من متابعة هذه الخطوة والاستفادة من كافة المزايا.',
                textAlign: TextAlign.center,
                style: Theme.of(ctx).textTheme.bodyMedium?.copyWith(
                      color: Theme.of(ctx).colorScheme.onSurface.withOpacity(0.7),
                    ),
              ),
              const SizedBox(height: 24),
              SizedBox(
                width: double.infinity,
                height: 50,
                child: FilledButton(
                  onPressed: () {
                    Navigator.of(ctx).pop();
                    if (onLoginPressed != null) {
                      onLoginPressed();
                    } else {
                      // Navigate to auth screen if named route exists
                      // Navigator.of(context).pushNamed('/login');
                    }
                  },
                  child: const Text('تسجيل الدخول'),
                ),
              ),
              const SizedBox(height: 12),
              SizedBox(
                width: double.infinity,
                child: TextButton(
                  onPressed: () => Navigator.of(ctx).pop(),
                  child: const Text('المتابعة كزائر'),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

/// Widget wrapper that guards tap gestures
class GuestGuardWidget extends StatelessWidget {
  final Widget child;
  final VoidCallback onAuthorizedTap;
  final AuthCheckCallback? isAuth;
  final VoidCallback? onLoginPressed;

  const GuestGuardWidget({
    super.key,
    required this.child,
    required this.onAuthorizedTap,
    this.isAuth,
    this.onLoginPressed,
  });

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      behavior: HitTestBehavior.opaque,
      onTap: () {
        GuestGuard.run(
          context,
          action: onAuthorizedTap,
          isAuth: isAuth,
          onLoginPressed: onLoginPressed,
        );
      },
      child: child,
    );
  }
}
