import 'package:flutter/foundation.dart';

/// Modern Dart 3 Sealed Class for robust Async / UI State management.
///
/// Exhaustive pattern matching guarantees zero unhandled states:
/// ```dart
/// final widget = switch (state) {
///   AsyncInitial() => const SizedBox.shrink(),
///   AsyncLoading() => const CircularProgressIndicator.adaptive(),
///   AsyncSuccess(:final data) => MyDataView(data: data),
///   AsyncFailure(:final message) => ErrorView(message: message),
/// };
/// ```
@immutable
sealed class AsyncState<T> {
  const AsyncState();

  const factory AsyncState.initial() = AsyncInitial<T>;
  const factory AsyncState.loading() = AsyncLoading<T>;
  const factory AsyncState.success(T data) = AsyncSuccess<T>;
  const factory AsyncState.failure(String message, [Object? error, StackTrace? stackTrace]) = AsyncFailure<T>;

  bool get isInitial => this is AsyncInitial<T>;
  bool get isLoading => this is AsyncLoading<T>;
  bool get isSuccess => this is AsyncSuccess<T>;
  bool get isFailure => this is AsyncFailure<T>;

  T? get dataOrNull => switch (this) {
        AsyncSuccess(:final data) => data,
        _ => null,
      };

  String? get errorOrNull => switch (this) {
        AsyncFailure(:final message) => message,
        _ => null,
      };

  R when<R>({
    required R Function() initial,
    required R Function() loading,
    required R Function(T data) success,
    required R Function(String message, Object? error) failure,
  }) {
    return switch (this) {
      AsyncInitial() => initial(),
      AsyncLoading() => loading(),
      AsyncSuccess(:final data) => success(data),
      AsyncFailure(:final message, :final error) => failure(message, error),
    };
  }

  R maybeWhen<R>({
    R Function()? initial,
    R Function()? loading,
    R Function(T data)? success,
    R Function(String message, Object? error)? failure,
    required R Function() orElse,
  }) {
    return switch (this) {
      AsyncInitial() => initial != null ? initial() : orElse(),
      AsyncLoading() => loading != null ? loading() : orElse(),
      AsyncSuccess(:final data) => success != null ? success(data) : orElse(),
      AsyncFailure(:final message, :final error) => failure != null ? failure(message, error) : orElse(),
    };
  }
}

final class AsyncInitial<T> extends AsyncState<T> {
  const AsyncInitial();

  @override
  bool operator ==(Object other) => identical(this, other) || other is AsyncInitial<T>;

  @override
  int get hashCode => runtimeType.hashCode;

  @override
  String toString() => 'AsyncInitial<$T>()';
}

final class AsyncLoading<T> extends AsyncState<T> {
  const AsyncLoading();

  @override
  bool operator ==(Object other) => identical(this, other) || other is AsyncLoading<T>;

  @override
  int get hashCode => runtimeType.hashCode;

  @override
  String toString() => 'AsyncLoading<$T>()';
}

final class AsyncSuccess<T> extends AsyncState<T> {
  final T data;

  const AsyncSuccess(this.data);

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is AsyncSuccess<T> && runtimeType == other.runtimeType && data == other.data;

  @override
  int get hashCode => data.hashCode;

  @override
  String toString() => 'AsyncSuccess<$T>(data: $data)';
}

final class AsyncFailure<T> extends AsyncState<T> {
  final String message;
  final Object? error;
  final StackTrace? stackTrace;

  const AsyncFailure(this.message, [this.error, this.stackTrace]);

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is AsyncFailure<T> &&
          runtimeType == other.runtimeType &&
          message == other.message &&
          error == other.error;

  @override
  int get hashCode => Object.hash(message, error);

  @override
  String toString() => 'AsyncFailure<$T>(message: $message, error: $error)';
}
